# Local, dummy values only. `make` copies this file to .env (git-ignored) when .env is missing.
# Nothing here is a real secret, and nothing in this project talks to a real service.

# Password for the local Compose Postgres. It is reachable only inside the Compose network.
POSTGRES_PASSWORD=local-dummy-postgres-password

# HMAC secret mockshop signs webhooks with and the webhook receiver checks (phase 5).
SHOPIFY_WEBHOOK_SECRET=local-dummy-webhook-secret
