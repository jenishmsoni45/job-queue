# Local environment and secrets
.env

# Private working files (rough drafts, personal Claude Code settings)
.local/
.claude/settings.local.json

# OS
.DS_Store

# Generated by make (compose config for the compose check)
.cache/

# Console build and dependencies
console/node_modules/
console/dist/

# rapid writes failing cases here; they are local repro aids, not fixtures
**/testdata/rapid/

# Raw per-job bench exports: regenerated by make bench, never committed (D-052)
bench/results/*/*/raw/
